# Environment variables for um790-backup (docker-container)
# Generated by genproj, then extended to match what docker-compose.yml actually
# reads. Keys are derived from the docker-container `envVars` configuration;
# the NAS block was added by hand and the defaults there are real values, not
# placeholders. genproj never commits secrets - copy this to `.env` and fill in
# the two bottom entries.
#
# `.env` is git-ignored. It must never be committed: RESTIC_PASSWORD decrypts
# every snapshot on the NAS.

# --- secrets (no defaults; the run fails at the first gate without them) ----
# From Doppler, project um790-backup, config prd. Losing this loses the
# repository: restic has no recovery path without it, so keep a copy somewhere
# that is not this machine and not the same NAS.
RESTIC_PASSWORD=

# ntfy topic for success/failure notifications. Optional: with it empty the
# script logs "skipping notification" and continues, so a missing notifier can
# never turn a good backup red or a bad one green.
NTFY_URL=

# --- NAS facts (defaults are correct for this host; override only if the ----
# --- topology changes) -----------------------------------------------------
# Share-rooted, NOT /volume1-rooted: Synology's patched internal-sftp exposes
# share names as the root, so a /volume1 path fails with
# `not found share [volume1]`. scripts/bootstrap.sh builds this same value.
RESTIC_REPOSITORY=sftp:restic@192.168.1.2:/restic-target/um790

NAS_HOST=192.168.1.2
# sshd answers on 22 and 2222 here; neither is the default, so every transport
# passes this explicitly.
NAS_PORT=2222
# Shell user with NOPASSWD sudo, used by the snapshot phase only.
NAS_USER=nick

# --- per-run correlation (injected by the scheduler, not set by hand) ------
# The DAG exports this per step. If it is absent, preflight generates one, and
# then `snapshot.epoch >= backup_start.epoch` compares values from different
# runs - the ordering guard still holds, but the run is no longer traceable
# across its phases.
DAG_RUN_ID=

# --- retention -------------------------------------------------------------
# How long NAS-side Btrfs snapshots are kept, in WEEKS. Default 8, so
# SNAPSHOT_RETENTION_DAYS is derived as 56.
#
# This is the undo you can reach when the restic repository itself is the thing
# that broke, which is why it is measured in TIME and not in a count of
# snapshots. A count silently means "8 runs", so shortening the schedule would
# shorten the safety margin without changing a single number in the config.
#
# Leave it unset to take the default. Setting it below 2 (14 days) warns, because
# that keeps about one snapshot and therefore no previous point in time.
# SNAPSHOT_RETENTION_WEEKS=8

# Superseded by SNAPSHOT_RETENTION_WEEKS. Honoured, but now interpreted as
# WEEKS - so a leftover KEEP_SNAPSHOTS=8 keeps the same 56 days. It logs a
# deprecation warning so that a stale value in a scheduler config cannot silently
# decide your undo window. Do not use it in new configuration.
# KEEP_SNAPSHOTS=

# --- path overrides (defaults work; leave unset unless relocating) ---------
# Where preflight installs the exclude list inside the persistent mount. Must be
# the same path both the preflight container and the backup container can read.
EXCLUDES=/srv/.um790-backup/exclude.txt
