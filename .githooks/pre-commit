#!/bin/sh
# Generated by genproj — the local half of the secret-scanning gate.
#
# Installed by `scripts/setup-git-hooks.sh`, which sets
# `git config core.hooksPath .githooks`. That setting is what makes this file a
# hook: it lives in the repository, so a fresh clone carries it, and it needs no
# Node, no `package.json` and no package manager to be discovered.
#
# The scan is intentionally fail-open when the binary is missing: a
# half-provisioned container must not block commits. CI's full-history scan is
# the control that cannot be skipped — see .buildkite/pipeline.yml or
# .circleci/config.yml.
set -u

ROOT=$(git rev-parse --show-toplevel 2>/dev/null || pwd)
cd "$ROOT" || exit 1

GITLEAKS_BIN=${GITLEAKS_BIN:-}
if [ -z "$GITLEAKS_BIN" ]; then
  if command -v gitleaks >/dev/null 2>&1; then
    GITLEAKS_BIN=$(command -v gitleaks)
  elif [ -x "$HOME/.local/bin/gitleaks" ]; then
    GITLEAKS_BIN="$HOME/.local/bin/gitleaks"
  fi
fi

if [ -z "$GITLEAKS_BIN" ]; then
  echo "WARN: gitleaks is not installed - skipping the local secret scan." >&2
  echo "WARN: CI still scans the full history. Run scripts/setup-git-hooks.sh to install it." >&2
else
  echo "INFO: gitleaks: scanning staged changes..."
  if ! "$GITLEAKS_BIN" git --pre-commit --staged --redact --verbose .; then
    cat >&2 <<'EOF'
ERROR: gitleaks found a secret in the staged changes; the commit was blocked.

  1. Rotate the credential now - a finding means it may already be exposed.
  2. Remove it from the staged files and commit again.
  3. Only if the finding is a verified false positive, add its fingerprint to
     .gitleaksignore - that is a reviewable diff. Never use
     `git commit --no-verify`: it skips the scan and leaves no record.
EOF
    exit 1
  fi
fi

# lint-staged, when the project opted into `code-quality`. Invoking the local
# binary directly (rather than `npx`) keeps the hook working offline.
if [ -f package.json ] && [ -x node_modules/.bin/lint-staged ]; then
  node_modules/.bin/lint-staged || exit $?
fi

exit 0
