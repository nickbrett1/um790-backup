# Single-stage image for um790-backup
# Generated by genproj (docker-container capability, language=shell), then
# specialised: this is a batch workload that runs phases and exits.
#
# A shell project has nothing to compile: the deliverable is the entrypoint
# script plus the CLI tools it calls. A multi-stage build here would emit a
# `build` stage that copies nothing into a `runtime` stage - noise, and an
# extra image layer to explain.
#
# Why each apt package is here:
#   sqlite3        .backup / VACUUM INTO / integrity_check for the SQLite dumps
#   jq             parse `restic snapshots --json` and `docker inspect`
#   curl           ntfy notifications
#   openssh-client both SSH transports: `sftp` to the restic user, `ssh` to nick
#   docker.io      the CLI only - `docker ps/inspect/exec` against the mounted
#                  socket. The daemon is never started in this image.
#   bzip2          decompress the pinned restic release in install-restic.sh
#   ca-certificates, coreutils (numfmt) come from the base or are pulled in above
FROM debian:bookworm-slim
WORKDIR /app

# Run in UTC, EXPLICITLY. Debian's default is already UTC, but "default" is not
# a guarantee: a bind-mounted /etc/localtime or a TZ in an env file would change
# it, and the effect is silent.
#
# The reason is comparability, not a claim about restic internals: snapshot
# names printed by DSM are UTC wall-clock, and the sweep parses them as UTC. If
# the container formatted timestamps in a host zone, log lines and
# last_success.json would be offset from the names they refer to, and reading a
# run log against a snapshot list would require mental arithmetic. A fixed zone
# also makes output reproducible between the build host and the NAS.
#
# Deliberately NOT claimed here: that restic's --keep-daily buckets by local
# calendar day and therefore needs UTC to be correct. That was asserted once in
# this file's history and it did not survive testing - pinning TZ=UTC did not
# change a same-day keep-daily result, so it was never established as the cause.
# The retention test now asserts keep-daily over consecutive days, which is
# stable under any uniform offset, so it tests the policy without depending on
# this explanation being true. Do not reintroduce the claim without evidence.
ENV TZ=UTC

# Link the GHCR container package to its GitHub repo on push. GHCR auto-links
# the package to nickbrett1/um790-backup so it inherits the repo's access
# (public repo -> public package; no manual visibility step).
LABEL org.opencontainers.image.source=https://github.com/nickbrett1/um790-backup

RUN apt-get update && apt-get install -y --no-install-recommends \
      sqlite3 jq curl openssh-client ca-certificates coreutils \
      docker.io bzip2 tzdata \
    && rm -rf /var/lib/apt/lists/*

# restic is installed at BUILD time, not from the entrypoint. Bookworm's own
# package is 0.14 (too old for `check --read-data-subset`), so this fetches and
# checksums a pinned release - and doing it here keeps the CI smoke gate
# (`docker run ... --dry-run`) offline and fast.
COPY scripts/install-restic.sh /usr/local/bin/install-restic.sh
RUN chmod +x /usr/local/bin/install-restic.sh \
    && /usr/local/bin/install-restic.sh \
    && rm -f /usr/local/bin/install-restic.sh \
    && restic version

COPY . .

# preflight installs /app/deploy/exclude.txt into the state mount and refuses to
# run without it, so an image missing that file can only fail - at 02:00, on the
# host, under a taken lock. Assert it here instead, where the build goes red and
# nobody has to be woken up. `-s` not `-e`: an empty exclude list would otherwise
# pass and silently back up every Postgres data directory on /srv.
RUN test -s deploy/exclude.txt \
    || { echo "FATAL: deploy/exclude.txt missing or empty - preflight would refuse to run" >&2; exit 1; }

# The TZ above is a decision the backup depends on, so prove it in the build
# rather than trusting the ENV line. If a future base image or apt layer changes
# the effective zone, this goes red here instead of quietly offsetting every
# timestamp months later. Compares the zone OFFSET (via %z), which is what
# actually breaks: a same-year comparison passes for any whole-hour offset.
RUN test "$(date +%z)" = "+0000" \
    || { echo "FATAL: container is not running in UTC - log timestamps would not match UTC snapshot names" >&2; exit 1; }

COPY scripts/um790-backup.sh /usr/local/bin/um790-backup.sh
RUN chmod +x /usr/local/bin/um790-backup.sh

# No EXPOSE, no HEALTHCHECK: this is a batch job that runs a phase and exits.
# A healthcheck on a workload with no listener would fail the smoke gate.
ENTRYPOINT ["/usr/local/bin/um790-backup.sh"]
